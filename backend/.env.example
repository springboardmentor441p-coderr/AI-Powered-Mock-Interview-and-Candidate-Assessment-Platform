# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgres://smarthire:smarthire@localhost:5432/smarthire
POSTGRES_DB=smarthire
POSTGRES_USER=smarthire
POSTGRES_PASSWORD=smarthire
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT
ACCESS_TOKEN_LIFETIME_MIN=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# AI provider used for resume extraction (skills, technologies, summary, etc.)
# "mock"   (default) - deterministic keyword-based extraction, no keys needed.
# "openai" - real extraction via OpenAI (requires OPENAI_API_KEY).
# "gemini" - real extraction via Google Gemini (requires GEMINI_API_KEY).
AI_SERVICE_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_RESUME_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_RESUME_MODEL=gemini-2.5-flash
WHISPER_API_KEY=

# Publicly reachable URL for this backend (Ultravox calls webhooks on
# this from the outside - use an ngrok/cloudflared tunnel URL in dev)
BACKEND_PUBLIC_URL=http://localhost:8000

# Realtime voice provider (Ultravox) - controls live-call voice AI only.
# "mock"     (default) - no real call, lets the full session lifecycle be
#            exercised end-to-end without an Ultravox account.
# "ultravox" - real Ultravox voice calls (requires ULTRAVOX_API_KEY).
# Falls back to AI_SERVICE_PROVIDER if left blank, so leaving this unset
# behaves exactly like before. Set explicitly to run e.g. gemini for text
# tasks + ultravox for voice at the same time.
REALTIME_VOICE_PROVIDER=

ULTRAVOX_API_KEY=
ULTRAVOX_MODEL=fixie-ai/ultravox
ULTRAVOX_VOICE=Mark
ULTRAVOX_RECORDING_ENABLED=False
ULTRAVOX_TOOL_SHARED_SECRET=
ULTRAVOX_WEBHOOK_SECRET=

# How long an interview call may run, and how the orchestrator paces
# itself against that budget (provider-agnostic - used for both the
# vendor's hard cutoff and ask_next_question's wrap-up nudging).
INTERVIEW_MAX_DURATION_SECONDS=2700
INTERVIEW_SOFT_WRAPUP_PERCENT=80
INTERVIEW_HARD_WRAPUP_BUFFER_SECONDS=90

# Email provider: "smtp" (default) or "sendgrid"
EMAIL_PROVIDER=smtp
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@smarthire.ai
SENDGRID_API_KEY=

# Google OAuth2 (optional)
GOOGLE_OAUTH2_CLIENT_ID=
GOOGLE_OAUTH2_CLIENT_SECRET=

# Security (production)
SECURE_SSL_REDIRECT=False

# Monitoring (production)
SENTRY_DSN=
