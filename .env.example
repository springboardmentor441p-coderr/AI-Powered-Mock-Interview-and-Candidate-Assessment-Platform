ULTRAVOX_API_KEY=paste_your_ultravox_key_here
DEEPGRAM_API_KEY=paste_your_deepgram_key_here
# Leave disabled to preserve deterministic interview generation. To enable the
# LLM interview agent, set LLM_PROVIDER=gemini and provide a real Gemini key.
LLM_PROVIDER=disabled
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
