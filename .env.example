FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-secret-key-in-production
JWT_SECRET_KEY=change-this-jwt-secret-key-in-production

# Database (SQLite for dev, MySQL for production)
DATABASE_URL=sqlite:///smarthire.db
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smarthire

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Upload settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# App settings
APP_NAME=InterviewIQ
APP_URL=http://localhost:5000
